# Codemagic 环境变量模板（复制到 Codemagic → Teams → Environment variable groups）
# 真实值请填 scripts/codemagic-secrets/ 目录下对应文件，勿提交 secrets

# --- Group: app_store_credentials（全部 Secure）---
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_IDENTIFIER=
APP_STORE_CONNECT_PRIVATE_KEY=
APP_STORE_APPLE_ID=

# --- Group: certificate_credentials（Secure）---
CERTIFICATE_PRIVATE_KEY=
